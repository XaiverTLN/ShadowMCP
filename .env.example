GROQ_API_KEY=
GEMINI_API_KEY=
SHADOWMCP_ENV=dev
# Optional custom-tool rate-limit override; blank keeps the limit enabled.
JUDGE_PASSCODE=
# Required for server-wide quarantine and HITL actions; blank keeps them locked.
SHADOWMCP_OPERATOR_PASSCODE=
# Preset buttons use the deterministic local judge so the demo always lands SAFE/HONEYPOT/REVIEW (1=on, 0=live LLM)
SHADOWMCP_DETERMINISTIC_PRESETS=1
# Public deploys: 1 = never use the keys above for visitors; they must enter their own in the sidebar
SHADOWMCP_REQUIRE_BYOK=1
# Seconds to skip a provider after it fails (circuit breaker)
SHADOWMCP_BREAKER_SECONDS=60
# Models (verified working 2026-11-07; change here if a model is retired)
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite
GEMINI_PRO_MODEL=gemini-3.1-flash-lite

# Gemini "thinking" level for speed: none | low | medium (none = fastest, ~0.9s median)
GEMINI_REASONING_EFFORT=none
# Per-call LLM timeout in seconds (falls back to the next tier when exceeded)
LLM_TIMEOUT_SECONDS=3.5

# Optional local JSONL event log; it stores prompts and tool arguments. Disabled by default.
# SHADOWMCP_EVENT_LOG=
